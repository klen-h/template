{
  "name": "vue2temp",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "author": "klen",
  "packageManager": "pnpm@6.14.6",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vue-cli-service serve",
    "warning": "echo '如果切换了分支，请检查是否重新安装了依赖保证node_modules的正确性'",
    "build": "npm run warning && vue-cli-service build --mode production",
    "build:test": "npm run warning && vue-cli-service build --mode produtest",
    "report": "vue-cli-service build  --report",
    "lint": "vue-cli-service lint",
    "upload:test": "node upload/index.js test",
    "upload": "node upload/index.js prod",
    "deploy": "npm run build && npm run upload",
    "deploy:test": "npm run build:test && npm run upload:test"
  },
  "dependencies": {
    "axios": "^1.3.5",
    "core-js": "^3.30.1",
    "js-cookie": "^3.0.1",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "vant": "~2",
    "vue": "2.6.14",
    "vue-router": "~3",
    "vuex": "~3"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4",
    "@vue/cli-plugin-eslint": "~4",
    "@vue/cli-plugin-router": "~4",
    "@vue/cli-plugin-vuex": "~4",
    "@vue/cli-service": "4.4.6",
    "@vue/eslint-config-prettier": "^6.0.0",
    "autoprefixer": "~9",
    "babel-eslint": "^10.1.0",
    "babel-loader": "8",
    "babel-plugin-import": "^1.13.6",
    "cz-customizable": "^6.3.0",
    "eslint": "^6.7.2",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-import-resolver-webpack": "^0.13.2",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^6.2.2",
    "husky": "8.0.3",
    "lint-staged": "^9.5.0",
    "postcss-pxtorem": "~5",
    "prettier": "^2.7.1",
    "sass": "1.62.0",
    "sass-loader": "^8.0.2",
    "sass-resources-loader": "^2.2.5",
    "ssh2-sftp-client": "9.0.0",
    "vue-template-compiler": "2.6.14"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue}": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}