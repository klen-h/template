{
    "name": "vue3-admin-template",
    "version": "1.0.0",
    "license": "UNLICENSED",
    "private": true,
    "author": "",
    "packageManager": "pnpm@9.12.2",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite --mode development --host",
        "warning": "echo '\\x1b[31m如果切换了分支，请检查是否重新安装了依赖保证node_modules的正确性\\x1b[0m'",
        "build": "pnpm run warning && vite build --mode production",
        "build:test": "pnpm run warning && vite build --mode test",
        "preview": "pnpm run build && vite preview",
        "preview:test": "pnpm run build:test && vite preview",
        "upload": "sftp2 -p dist -t admins/testAdmin && node scripts/deploy/push-tag.js",
        "upload:test": "sftp2 -p dist -t admins/testAdmin/test",
        "lint": "eslint --ext .js,.jsx,.vue,.ts,.tsx src",
        "lintfix": "eslint --ext .js,.jsx,.vue,.ts,.tsx src --fix",
        "deploy": "pnpm run build && pnpm run upload",
        "deploy:test": "pnpm run build:test && pnpm run upload:test",
        "prepare": "husky install"
    },
    "lint-staged": {
        "*.{vue,js,ts}": "eslint --fix"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@tinymce/tinymce-vue": "^5",
        "@vicons/antd": "^0",
        "@vueuse/core": "^11",
        "axios": "^1",
        "core-js": "^3",
        "debugout.js": "^1",
        "element-plus": "^2.8.7",
        "element-resize-detector": "^1",
        "js-cookie": "^3",
        "lodash-es": "^4",
        "mitt": "^3",
        "moment-mini": "^2",
        "nprogress": "^0",
        "path": "^0",
        "path-to-regexp": "^8",
        "pinia": "^2",
        "vue": "3.5.12",
        "vue-router": "4.4.5",
        "vuedraggable-es": "^4"
    },
    "devDependencies": {
        "@types/echarts": "^4",
        "@types/file-saver": "^2",
        "@types/lodash-es": "^4",
        "@types/mockjs": "^1",
        "@types/node": "^22",
        "@typescript-eslint/eslint-plugin": "^8",
        "@typescript-eslint/parser": "^8",
        "@unocss/preset-attributify": "^0",
        "@vitejs/plugin-basic-ssl": "^1",
        "@vitejs/plugin-legacy": "^5",
        "@vitejs/plugin-vue": "^5",
        "@vitejs/plugin-vue-jsx": "^4",
        "@vue/compiler-sfc": "^3",
        "@vue/eslint-config-typescript": "^13",
        "autoprefixer": "^10",
        "chalk": "^5",
        "cross-env": "^7",
        "cz-conventional-changelog": "^3",
        "cz-customizable": "^7",
        "eslint": "^8",
        "eslint-config-airbnb-base": "^15",
        "eslint-plugin-import": "^2",
        "eslint-plugin-vue": "^9",
        "fs-extra": "^11",
        "husky": "^9",
        "lint-staged": "^15",
        "log-symbols": "^7",
        "mockjs": "^1",
        "postcss": "^8",
        "rollup": "^4",
        "sass": "^1",
        "svg-sprite-loader": "^6",
        "terser": "^5",
        "typescript": "^5",
        "unocss": "^0",
        "unplugin-auto-import": "^0",
        "unplugin-vue-components": "^0",
        "vite": "^5.4.11",
        "vite-plugin-babel-import": "^2",
        "vite-plugin-mock": "^3",
        "vite-plugin-parse-html": "^2",
        "vite-plugin-qiankun": "^1",
        "vite-plugin-style-import": "^2",
        "vite-plugin-svg-icons": "^2",
        "webpack": "^5"
    },
    "browserslist": [
        "> 1%",
        "not ie 11",
        "not op_mini all"
    ],
    "engines": {
        "node": ">=18.13.0"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-customizable"
        }
    }
}
